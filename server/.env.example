PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/manor_tea
JWT_SECRET=change-me-to-a-long-random-string

# Initial admin (seed)
ADMIN_EMAIL=admin@manor.com
ADMIN_PASSWORD=manoradmin
ADMIN_NAME=MANOR Admin
SEED_SAMPLE_DATA=false

# Comma-separated list of allowed origins for CORS in development
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173

# Optional SMTP (for order emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
