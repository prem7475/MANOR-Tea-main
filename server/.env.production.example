NODE_ENV=production
PORT=8080
MONGODB_URI=your-atlas-connection-string
JWT_SECRET=replace-with-strong-secret

# Initial admin seed (run once with `npm run seed`)
ADMIN_EMAIL=admin@manor.com
ADMIN_PASSWORD=change-this
ADMIN_NAME=MANOR Admin

# Comma-separated CORS origins
CORS_ORIGINS=https://www.example.com,https://admin.example.com

# Optional SMTP (for order emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
